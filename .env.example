# .env.example
# Copia este archivo como .env y completa con tus credenciales

# Django
DEBUG=True
SECRET_KEY=genera-una-clave-secreta-aqui
ALLOWED_HOSTS=localhost,127.0.0.1

# Flow - Sandbox (para desarrollo)
FLOW_SANDBOX=True
FLOW_SANDBOX_API_KEY=tu-api-key-sandbox
FLOW_SANDBOX_SECRET_KEY=tu-secret-key-sandbox

# Flow - Producción
FLOW_PROD_API_KEY=tu-api-key-produccion
FLOW_PROD_SECRET_KEY=tu-secret-key-produccion