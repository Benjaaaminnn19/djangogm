{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
      "builder": "NIXPACKS",
      "nixpacksConfigPath": "nixpacks.toml"
    },
    "deploy": {
      "numReplicas": 1,
      "startCommand": "gunicorn gym_leblon.wsgi:application --bind 0.0.0.0:$PORT",
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10
    }
  }